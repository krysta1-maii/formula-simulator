{
  "name": "formula-simulator",
  "version": "0.4.1",
  "private": true,
  "description": "方程式赛车动力学模拟器 · 内置卧式悬挂与六自由度车身",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:check": "node tools/check-build.mjs --strict",
    "test": "node tools/test-core.mjs && node tools/test-dynamics.mjs",
    "test:core": "node tools/test-core.mjs",
    "test:dynamics": "node tools/test-dynamics.mjs",
    "test:invariants": "node tools/test-physics-invariants.mjs",
    "test:runtime": "node tools/test-runtime.mjs",
    "test:build": "node tools/test-build.mjs",
    "ci:node": "npm test && npm run test:invariants && npm run test:runtime && npm run test:dev-server && npm run test:build",
    "ci": "npm run build:check && npm run ci:node && npm run ci:browser && npm run audit && npm run audit:baseline",
    "bench": "node tools/bench.mjs",
    "test:browser": "node tools/test-dynamics-browser.mjs",
    "test:suspension": "node tools/test-suspension-packaging.mjs",
    "test:camera": "node tools/test-camera.mjs",
    "test:ui": "node tools/test-ui-browser.mjs",
    "test:dev-server": "node tools/test-dev-server.mjs",
    "audit": "node tools/audit/run-all.mjs",
    "audit:physics": "node tools/audit/run-all.mjs --group physics",
    "audit:contact": "node tools/audit/run-all.mjs --group contact",
    "audit:runtime": "node tools/audit/run-all.mjs --group runtime",
    "audit:ui": "node tools/audit/run-all.mjs --group ui",
    "audit:browser": "node tools/audit/run-all.mjs --group browser",
    "audit:baseline": "node tools/audit/run-all.mjs --expect-baseline",
    "audit:update": "node tools/audit/run-all.mjs --update-baseline",
    "docs:capture": "node tools/build.mjs && node tools/capture-docs.mjs",
    "dev": "node tools/dev-server.mjs",
    "ci:browser": "npm run build:check && node tools/browser-runner.mjs --ci"
  },
  "engines": {
    "node": ">=18"
  }
}
